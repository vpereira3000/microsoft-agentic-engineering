# PUBLIC EXAMPLE ONLY. All private values are masked with asterisks.
# Replace them locally before running. Never upload real credentials to GitHub.
# Keep your populated local .env excluded from Git using .gitignore.

# Microsoft Entra application registration: use the secret VALUE, not its ID.
AZURE_TENANT_ID=*****
AZURE_CLIENT_ID=*****
AZURE_CLIENT_SECRET=*****

# Copy the Project endpoint from your Microsoft Foundry project locally.
# Expected structure: https://*****.services.ai.azure.com/api/projects/*****
AZURE_PROJECT_ENDPOINT=*****

# Must match an existing deployment in the resource used by the project.
AZURE_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Optional settings retained for future experiments.
# They are not used to authenticate the FoundryChatClient request below.
AZURE_API_KEY=*****
AZURE_OPENAI_ENDPOINT=*****
AZURE_AI_REGION=*****
